{
	"version": "0.2.0",
	"configurations": [
		

		{
			"type": "node",
			"request": "launch",
			"name": "Jest: debug power.log → console",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": [
				"--config=libs/power-log-parser/jest.config.ts",
				"--runInBand",
				"--no-cache",
				"--testPathPattern=debug-power-log-console"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Jest: debug power.log (full JSON lines)",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": [
				"--config=libs/power-log-parser/jest.config.ts",
				"--runInBand",
				"--no-cache",
				"--testPathPattern=debug-power-log-console"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"env": {
				"POWER_LOG_DEBUG_FULL": "1"
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Jest: debug Ivory Rook power-log replay (game-state)",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": [
				"libs/game-state/src/testing/power-log-ivory-rook-replay.spec.ts",
				"--config=libs/game-state/jest.config.ts",
				"--runInBand",
				"--no-cache"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen"
		}
	]
}
