# Copy to `.env.signing` (gitignored) and fill in the secret values.
# Share `.env.signing` between your machines via a password manager / secure channel —
# do NOT commit it, even though the repo is private.
#
# Non-secret Azure IDs are filled in; only the secret/API keys need pasting.

# Azure Artifact Signing (App registration: firestone-codesigning)
AZURE_TENANT_ID=ebd5b9de-ab7d-4dd4-964f-b2b013969f34
AZURE_CLIENT_ID=29321fe1-1658-4bbf-815e-b9561b6421c4
AZURE_CLIENT_SECRET=

# Overwolf ow-electron package integrity signing (builds) AND local Dev Mode
# (OW_CLI_EMAIL + OW_CLI_API_KEY are loaded into restart:ow-electron via with-signing-env.mjs).
# https://dev.overwolf.com/ow-electron/guides/dev-tools/app-signing/
# https://dev.overwolf.com/ow-electron/guides/dev-tools/dev-mode
OW_CLI_EMAIL=
OW_CLI_API_KEY=
OW_BUILD_KEY=
