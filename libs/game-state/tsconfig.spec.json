{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"module": "commonjs",
		"types": ["jest", "node"],
		"isolatedModules": true
	},
	"files": ["src/test-setup.ts"],
	"include": [
		"jest.config.ts",
		"**/*.test.ts",
		"**/*.spec.ts",
